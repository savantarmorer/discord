# ============================================
# CONFIGURAÇÃO DO BOT DISCORD
# ============================================
# Token do bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=seu_token_aqui

# ID da aplicação (Discord Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=seu_client_id_aqui

# ID do servidor (Guild) — clique com botão direito no ícone do servidor com modo desenvolvedor ativado
DISCORD_GUILD_ID=seu_guild_id_aqui

# ============================================
# CONFIGURAÇÃO DO SUPABASE
# ============================================
# URL do projeto Supabase (Settings > API > Project URL)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima ou service_role (Settings > API > anon/service_role key)
SUPABASE_KEY=sua_chave_aqui

# Opcional — chave service_role (Settings > API > service_role key), necessária
# apenas para a gravação completa de calls (bucket call-recordings no Storage).
# Sem essa variável, a gravação de call inteira fica desativada automaticamente.
SUPABASE_SERVICE_KEY=

# Opcional — ID do canal de texto onde o bot posta os links das gravações de call.
RECORDINGS_CHANNEL_ID=

# Opcional — cargo exigido para usar /calls e /renomearcall (arquivo de
# gravações antigas). Sem essa variável, ninguém tem acesso ao arquivo.
CALLS_ARCHIVE_ROLE_ID=

# ============================================
# BOT DE REPRODUÇÃO (src/player/ — processo e serviço Render separados)
# ============================================
# Token/Client ID de uma SEGUNDA aplicação Discord (não a mesma do bot
# principal — o Discord só permite uma conexão de voz por servidor por bot).
PLAYER_BOT_TOKEN=
PLAYER_BOT_CLIENT_ID=
# ID do canal de voz dedicado onde ele toca as gravações.
PLAYER_VOICE_CHANNEL_ID=
# DISCORD_GUILD_ID, SUPABASE_URL, SUPABASE_KEY, SUPABASE_SERVICE_KEY e
# CALLS_ARCHIVE_ROLE_ID são os mesmos valores já definidos acima.
